# Copy to .env on the VPS (same folder as docker-compose.yml) and fill in.
# Generate secrets with:  openssl rand -hex 32

APP_URL=https://vcreatorclub.in

POSTGRES_PASSWORD=change_me_long_random

# Signs the login session cookie
SESSION_SECRET=change_me_64_hex_chars

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: https://vcreatorclub.in/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# One-time admin bootstrap (README → "First admin"). Set back to false after use.
ADMIN_SEED_SECRET=change_me_at_least_16_chars
ENABLE_ADMIN_SEED=true
