# Local development — copy to api/.env
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vcc
APP_URL=http://localhost:4200
SESSION_SECRET=dev-only-change-me-0123456789abcdef
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_SEED_SECRET=dev-seed-secret-0123456789
ENABLE_ADMIN_SEED=true
# Lets you sign in without Google at /api/auth/dev-login?email=you@x.com&returnTo=/admin
# Ignored when NODE_ENV=production.
ENABLE_DEV_LOGIN=true
