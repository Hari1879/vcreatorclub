# Local development — copy to api/.env
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vcc
APP_URL=http://localhost:4200
SESSION_SECRET=dev-only-change-me-0123456789abcdef
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_SEED_SECRET=dev-seed-secret-0123456789
ENABLE_ADMIN_SEED=true
# Lets you sign in without Google at /api/auth/dev-login?email=you@x.com&returnTo=/admin
# Ignored when NODE_ENV=production.
ENABLE_DEV_LOGIN=true
# YouTube Data API v3 key for GET /api/creators/follower-count (503 if unset)
YOUTUBE_API_KEY=
# Email via Resend. Leave RESEND_API_KEY empty in dev: emails are logged and marked 'skipped'.
RESEND_API_KEY=
MAIL_FROM=VCC Creator Club <noreply@vcreatorclub.in>
# Optional, comma-separated: get a short alert on every new enrollment
ADMIN_ALERT_EMAILS=
# Co-Create: base64 32 bytes (openssl rand -base64 32); required for paid/combined requests
CO_CREATE_ENC_KEY=
CO_CREATE_NOTIFY_EMAIL=
